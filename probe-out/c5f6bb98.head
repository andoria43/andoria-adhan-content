{"code":200,"status":"OK","data":{"number":3,"ayahs":[{"number":13,"text":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ سَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ","surah":{"number":2,"name":"سُورَةُ البَقَرَةِ","englishName":"Al-Baqara","englishNameTranslation":"The Cow","numberOfAyahs":286,"revelationType":"Medinan"},"numberInSurah":6,"juz":1,"manzil":1,"page":3,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":14,"text":"خَتَمَ ٱللَّهُ عَلَىٰ قُلُوب�